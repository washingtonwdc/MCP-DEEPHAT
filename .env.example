# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - MCP DEEPHAT AI (https://app.deephat.ai)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONEXÃO DIRETA COM O SITE (app.deephat.ai) - RECOMENDADO
# ------------------------------------------------------------------------------
# Como obter o cookie da sua sessão web:
# 1. Acesse https://app.deephat.ai no navegador (Chrome, Edge, etc.)
# 2. Faça login normalmente com sua conta (GitHub ou Google).
# 3. Abra o DevTools pressionando F12 (ou Ctrl + Shift + I).
# 4. Vá na aba "Application" (ou "Aplicativo") -> "Cookies" -> "https://app.deephat.ai".
# 5. Procure o cookie "__Secure-next-auth.session-token" ou copie todos os cookies.
#    - Você pode colar o cookie completo abaixo em DEEPHAT_COOKIE:
DEEPHAT_COOKIE=

# Ou, se preferir, cole apenas o valor do token __Secure-next-auth.session-token aqui:
DEEPHAT_SESSION_TOKEN=

# ------------------------------------------------------------------------------
# 2. CONEXÃO VIA API KINDO / DEEPHAT OFICIAL (FALLBACK OU DIRETA)
# ------------------------------------------------------------------------------
# Caso possua chave de API Kindo para o modelo DeepHat-V1-7B:
KINDO_API_KEY=
KINDO_API_BASE=https://api.kindo.ai/v1
DEEPHAT_MODEL=DeepHat/DeepHat-V1-7B

# ------------------------------------------------------------------------------
# 3. PARÂMETROS OPERACIONAIS
# ------------------------------------------------------------------------------
# Modo de conexão: 'auto' (prioriza web, fallback p/ api), 'web' ou 'api'
CONNECTION_MODE=auto

# Timeout de rede em segundos
TIMEOUT_SECONDS=120.0
